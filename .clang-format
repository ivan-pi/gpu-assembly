# C++ and CUDA formatting, applied by pre-commit and by the Claude Code
# PostToolUse hook (.claude/hooks/format.sh); see docs/developers.md.
#
# Hand-aligned tables sit between `// clang-format off` and
# `// clang-format on`.
---
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100

# Parameters that do not fit on one line go one per line, not packed,
# and not all together on a continuation line either. Arguments at the
# call site stay packed.
BinPackParameters: OnePerLine
AllowAllParametersOfDeclarationOnNextLine: false
PenaltyReturnTypeOnItsOwnLine: 1000

# A short `if (pred) statement;` may stay on one line; a loop body goes
# on its own line.
AllowShortLoopsOnASingleLine: false

# Google derives pointer alignment per file; fix it instead.
DerivePointerAlignment: false
PointerAlignment: Left

# Sort includes within a block but keep the blank-line grouping
# (standard library, third party, project) the author chose.
IncludeBlocks: Preserve
